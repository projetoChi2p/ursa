#zed
part=xc7z020clg484-1

[hls]
flow_target=vivado
package.output.format=ip_catalog
package.output.syn=true

tb.file=__ROOT_DIR__/tb/simple_mxm/matrices.cpp
tb.file=__ROOT_DIR__/tb/simple_mxm/matrices.h
tb.file=__ROOT_DIR__/tb/simple_mxm/tb_main.cpp

syn.file=__ROOT_DIR__/src/settings.h
syn.file=__ROOT_DIR__/src/core/pe.cpp
syn.file=__ROOT_DIR__/src/core/pe.h
syn.file=__ROOT_DIR__/src/core/sa.cpp
syn.file=__ROOT_DIR__/src/core/sa.h
syn.file=__ROOT_DIR__/src/core/shell.cpp
syn.file=__ROOT_DIR__/src/core/shell.h

syn.top=mxm_execute_ursa
clock=10
syn.interface.m_axi_max_bitwidth=32
syn.interface.m_axi_addr64=0

package.ip.display_name=URSA __VARIANT__ __SZ__x__SZ__ acc__ACC__
syn.cflags=-DSA_SIZE=__SZ__ -DACC_BITS=__ACC__ -I__ROOT_DIR__/src
tb.cflags=-DSA_SIZE=__SZ__ -DACC_BITS=__ACC__ -I__ROOT_DIR__/src

#package.ip.description=URSA systolic array, __SZ__x__SZ__ PEs, A=int8, B=uint8, C=int32, accumulator __ACC__ bits
